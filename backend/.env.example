# Application
APP_NAME="Fintech Operations Dashboard"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fintech_ops
DATABASE_ECHO=false

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Secrets encryption (Fernet key for MFA secrets at rest — generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
ENCRYPTION_KEY=change-me-to-a-generated-fernet-key-in-production

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Security
BCRYPT_ROUNDS=12
